# deploy/compose-vm settings. Copy to .env and edit; sprig-vm.sh and
# `docker compose` both read it. Every value has a default in compose.yaml.

COMPOSE_PROJECT_NAME=sprigdb
# The image every SprigDB role runs (build-image.sh makes it; upgrade changes it).
SPRIGDB_IMAGE=sprigdb:dev
MARIADB_IMAGE=mariadb:11.8
ETCD_IMAGE=quay.io/coreos/etcd:v3.6.5

# This DC's id and the deployment id (chapter 23); the cluster's name.
SPRIG_DC=dc1
SPRIG_DEPLOYMENT_ID=sprigdb
SPRIG_CLUSTER_NAME=dc1-main
# The name or address clients use; it goes into the gateway certificate and
# into the address Kafka advertises. Extra names: SPRIG_TLS_SANS=DNS:db.example.com,IP:10.0.0.5
SPRIG_PUBLIC_HOST=127.0.0.1
SPRIG_TLS_SANS=
SPRIG_CERT_DAYS=397

# Client ports (all TLS). SPRIG_BIND_IP=127.0.0.1 keeps them off the network.
SPRIG_BIND_IP=0.0.0.0
SPRIG_MYSQL_PORT=3306
SPRIG_MARIADB_PORT=3307
SPRIG_HTTPS_PORT=8443
SPRIG_MONGO_PORT=27017
SPRIG_REDIS_PORT=6379
SPRIG_BOLT_PORT=7687
SPRIG_KAFKA_PORT=9092
SPRIG_AMQPS_PORT=5671
# Loopback only.
SPRIG_ADMIN_PORT=7480
SPRIG_METRICS_PORT=9090

# Memory (the container limits) and MariaDB sizing. A 16 GB VM: MariaDB 8g
# with a 5G buffer pool, gateway 3g, controller 1g, worker 1g, etcd 512m.
MARIADB_MEM_LIMIT=4g
MARIADB_BUFFER_POOL=2G
MARIADB_REDO_SIZE=1G
MARIADB_MAX_CONNECTIONS=1000
GATEWAY_MEM_LIMIT=2g
CONTROLLER_MEM_LIMIT=1g
WORKER_MEM_LIMIT=1g
ETCD_MEM_LIMIT=512m
SPRIG_CLUSTER_MEMORY_GB=4
SPRIG_CLUSTER_STORAGE_GB=100

# Logs: Docker's json-file driver, rotated.
SPRIG_LOG_MAX_SIZE=50m
SPRIG_LOG_MAX_FILES=5
SPRIG_LOG_LEVEL=info
