# deploy/compose-vm settings. Copy to .env and edit; sprig-vm.sh and
# `docker compose` both read it. Every value has a default in compose.yaml.

COMPOSE_PROJECT_NAME=sprigdb
# The image every SprigDB role runs (build-image.sh makes it; upgrade changes it).
SPRIGDB_IMAGE=sprigdb:dev
MARIADB_IMAGE=mariadb:11.8
ETCD_IMAGE=quay.io/coreos/etcd:v3.6.5

# This DC's id and the deployment id; the cluster's name.
SPRIG_DC=dc1
SPRIG_DEPLOYMENT_ID=sprigdb
SPRIG_CLUSTER_NAME=dc1-main
# The name or address clients use; it goes into the gateway certificate and
# into the address Kafka advertises. Extra names: SPRIG_TLS_SANS=DNS:db.example.com,IP:10.0.0.5
SPRIG_PUBLIC_HOST=127.0.0.1
SPRIG_TLS_SANS=
SPRIG_CERT_DAYS=397

# Client ports (all TLS). SPRIG_BIND_IP=127.0.0.1 keeps them off the network.
SPRIG_BIND_IP=0.0.0.0
SPRIG_MYSQL_PORT=3306
SPRIG_MARIADB_PORT=3307
SPRIG_HTTPS_PORT=8443
SPRIG_MONGO_PORT=27017
SPRIG_REDIS_PORT=6379
SPRIG_BOLT_PORT=7687
SPRIG_KAFKA_PORT=9092
SPRIG_AMQPS_PORT=5671
# Loopback only.
SPRIG_ADMIN_PORT=7480
SPRIG_METRICS_PORT=9090

# Memory (the container limits) and MariaDB sizing. A 16 GB VM: MariaDB 8g
# with a 5G buffer pool, gateway 3g, controller 1g, worker 1g, etcd 512m.
MARIADB_MEM_LIMIT=4g
MARIADB_BUFFER_POOL=2G
MARIADB_REDO_SIZE=1G
MARIADB_MAX_CONNECTIONS=1000
GATEWAY_MEM_LIMIT=2g
CONTROLLER_MEM_LIMIT=1g
WORKER_MEM_LIMIT=1g
ETCD_MEM_LIMIT=512m
SPRIG_CLUSTER_MEMORY_GB=4
SPRIG_CLUSTER_STORAGE_GB=100

# Logs: Docker's json-file driver, rotated.
SPRIG_LOG_MAX_SIZE=50m
SPRIG_LOG_MAX_FILES=5
SPRIG_LOG_LEVEL=info

# --- Several VMs (RUNBOOK.md, "High availability") -----------------------------
# Leave these unset for one VM. For a data center on three VMs, set them on
# each VM: the first VM runs compose.yaml:compose.ha.yaml, the second and
# third compose.gateway-vm.yaml.
#COMPOSE_FILE=compose.yaml:compose.ha.yaml
# This VM's number (node ids ctl-<n>, gw-<n>, wkr-<n>).
#SPRIG_VM_ID=1
# Only the first VM's controller bootstraps the deployment: false on the others.
#SPRIG_CONTROLLER_BOOTSTRAP=true
# The address the other VMs reach this VM at, and the interface the internal
# ports are published on (the private network).
#SPRIG_PRIVATE_HOST=10.0.0.11
#SPRIG_PRIVATE_IP=10.0.0.11
# Every VM's private address, for the internal certificates (init, on the first VM).
#SPRIG_INTERNAL_SANS=IP:10.0.0.11,IP:10.0.0.12,IP:10.0.0.13
# The admin API on the private address, so the other VMs' gateways can relay to it.
#SPRIG_ADMIN_BIND_IP=10.0.0.11
# etcd: this VM's member and the whole cluster (the same on every VM).
#SPRIG_ETCD_NAME=etcd-vm1
#SPRIG_ETCD_INITIAL_CLUSTER=etcd-vm1=https://10.0.0.11:2380,etcd-vm2=https://10.0.0.12:2380,etcd-vm3=https://10.0.0.13:2380
#SPRIG_ETCD_SEEDS='["https://10.0.0.11:2379","https://10.0.0.12:2379","https://10.0.0.13:2379"]'
# Internal ports (published on SPRIG_PRIVATE_IP; each binds on the same number).
#SPRIG_ETCD_CLIENT_PORT=2379
#SPRIG_ETCD_PEER_PORT=2380
#SPRIG_INTERNAL_PORT=7481
#SPRIG_PEER_PORT=7403
#SPRIG_BACKEND_PORT=3306
# Telemetry (/readyz for the load balancer, /metrics for Prometheus), on the
# private address.
#SPRIG_TELEMETRY_PORT_GATEWAY=9180
#SPRIG_TELEMETRY_PORT_CONTROLLER=9181
#SPRIG_TELEMETRY_PORT_WORKER=9182
#SPRIG_TELEMETRY_PORT_AGENT=9183
# Mutual TLS on the controllers' internal port (permits); true by default
# with compose.ha.yaml. false only while some controllers still run an
# older build without it.
#SPRIG_INTERNAL_TLS=true
# The name Kafka clients reach this VM's gateway at (one per VM).
#SPRIG_KAFKA_HOST=db1.example.com
# Every VM's private address, for Prometheus (sprig-vm.sh monitoring-config),
# and the configuration it then reads.
#SPRIG_VM_HOSTS=10.0.0.11,10.0.0.12,10.0.0.13
#SPRIG_PROMETHEUS_CONFIG=prometheus.ha.yml

# --- MariaDB high availability (RUNBOOK.md, "MariaDB high availability") ----------
# One MariaDB node per VM: a primary and two semi-sync replicas, one SprigDB
# cluster with failover. Add compose.db-ha.yaml to COMPOSE_FILE on every VM:
#COMPOSE_FILE=compose.yaml:compose.ha.yaml:compose.db-ha.yaml
# The nodes (db<SPRIG_VM_ID> is this VM's), the same on every VM, and the
# first primary.
#SPRIG_DB_NODES=db1=10.0.0.11:3306,db2=10.0.0.12:3306,db3=10.0.0.13:3306
#SPRIG_DB_PRIMARY=db1
#AGENT_MEM_LIMIT=256m
# Written by sprig-vm.sh configure once the cluster is registered.
#SPRIG_DB_CLUSTER_ID=

# --- Load balancer (compose.lb.yaml; RUNBOOK.md, "Load balancer") ----------------
# On the load balancer's VM: the gateways' private addresses, and where it
# listens (the client ports above).
#SPRIG_LB_GATEWAYS=10.0.0.11,10.0.0.12,10.0.0.13
#SPRIG_LB_BIND_IP=0.0.0.0
#SPRIG_LB_HEALTH_PORT=9180
#ENVOY_IMAGE=envoyproxy/envoy:v1.34.1

# --- Backups (RUNBOOK.md, "Backups") --------------------------------------------
# Where each backup is copied after it is taken: a directory (a mounted disk or
# share) or host:path (rsync over SSH). Unset: backups stay on this VM.
#SPRIG_BACKUP_COPY_TO=/mnt/sprig-backups
# Backups kept in backups/ on this VM.
SPRIG_BACKUP_KEEP=7
