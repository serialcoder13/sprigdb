# MariaDB 11.8 settings for a SprigDB-managed node, Compose-on-VM bundle.
# server_id, gtid_domain_id, the buffer pool, redo size and max_connections
# come from compose.yaml (.env).
[mariadbd]
log_bin                         = mariadb-bin
binlog_format                   = ROW
binlog_row_image                = FULL
binlog_row_metadata             = FULL
binlog_annotate_row_events      = ON
replicate_annotate_row_events   = ON
binlog_expire_logs_seconds      = 604800  # feed.retention_hours (168) x 3600
sync_binlog                     = 1
innodb_flush_log_at_trx_commit  = 1
innodb_io_capacity              = 2000
innodb_io_capacity_max          = 4000
gtid_strict_mode                = ON
log_slave_updates               = ON
max_allowed_packet              = 68157440
rpl_semi_sync_master_wait_point = AFTER_SYNC
rpl_semi_sync_master_timeout    = 10000
skip_name_resolve               = ON
open_files_limit                = 524288
table_open_cache_instances      = 8
# Memory beyond the buffer pool: no MyISAM tables, Aria only for on-disk
# temporary tables.
key_buffer_size                 = 16M
aria_pagecache_buffer_size      = 64M
tmp_table_size                  = 64M
max_heap_table_size             = 64M
# TLS only. Certificates from sprig-vm.sh init; MariaDB re-reads
# them on FLUSH SSL (RUNBOOK.md, "Rotating certificates").
ssl_ca                          = /run/sprig/tls/ca.pem
ssl_cert                        = /run/sprig/tls/mariadb.pem
ssl_key                         = /run/sprig/tls/mariadb-key.pem
require_secure_transport        = ON
tls_version                     = TLSv1.2,TLSv1.3
