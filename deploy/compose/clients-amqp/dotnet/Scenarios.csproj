<!-- AMQP 0-9-1 scenarios with RabbitMQ's .NET client (Apache-2.0 / MPL-2.0),
     pinned below; run.sh runs `dotnet run -c Release -- <args>` in the
     pinned SDK image. Test tooling only. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="RabbitMQ.Client" Version="6.8.1" />
  </ItemGroup>
</Project>
