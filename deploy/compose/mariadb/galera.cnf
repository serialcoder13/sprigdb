# Three-node Galera cluster (chapter 27). wsrep_node_address,
# wsrep_gtid_domain_id and the SST credentials are per node: see compose.yaml.
[mariadbd]
wsrep_on                 = ON
wsrep_provider           = /usr/lib/galera/libgalera_smm.so
wsrep_cluster_name       = sprig-dev-galera
wsrep_cluster_address    = gcomm://galera-1,galera-2,galera-3
wsrep_sst_method         = mariabackup
wsrep_gtid_mode          = ON
innodb_autoinc_lock_mode = 2
# Provider options (hardening round 1, HD1). The laptop runs at load 60-300
# when several agents test at once, so the defaults' 5 s suspect timeout made
# nodes drop each other during an SST and the cluster lose its primary
# component (the donor's BACKUP STAGE START then failed with "WSREP has not
# yet prepared node for application use" and the joiner aborted).
#  - evs.*: tolerate a starved scheduler for up to 30-60 s.
#  - gcache 512M + recover: a node that was down for a while rejoins by IST,
#    which costs far less than an SST (chapter 27 uses 2G in production).
#  - gcs.recv_q_hard_limit 256M: a joiner queues write-sets in memory during
#    SST; from 64M (the soft limit, 25%) replication is throttled instead of
#    the joiner growing until it is OOM-killed.
# None of these can be changed at runtime: a node picks them up when it starts.
wsrep_provider_options   = "gcache.size=512M;gcache.recover=yes;evs.suspect_timeout=PT30S;evs.inactive_timeout=PT60S;evs.install_timeout=PT60S;evs.keepalive_period=PT3S;evs.inactive_check_period=PT10S;evs.join_retrans_period=PT3S;gmcast.peer_timeout=PT10S;pc.wait_prim_timeout=PT120S;gcs.recv_q_hard_limit=256M;gcs.recv_q_soft_limit=0.25;gcs.max_throttle=0.25;gcs.fc_limit=64"

[sst]
# Under load the donor takes minutes to start streaming (11 s just to connect
# on 11 Nov); give the joiner time instead of giving up.
sst-idle-timeout = 900
