c_ms_x	CREATE TABLE `c_ms_x` (
  `a` int DEFAULT NULL,
  `b` int DEFAULT NULL,
  `s` varchar(20) DEFAULT NULL,
  `d` date DEFAULT NULL,
  `g1` int GENERATED ALWAYS AS ((`a` + 1)) VIRTUAL,
  `g2` int GENERATED ALWAYS AS (((`a` * `b`) - 2)) STORED,
  `g3` varchar(40) GENERATED ALWAYS AS (concat(`s`,_utf8mb4'x',lower(`s`))) VIRTUAL,
  `g4` int GENERATED ALWAYS AS ((case when (`a` > 0) then 1 else 0 end)) VIRTUAL,
  `g5` int GENERATED ALWAYS AS (if((`a` is null),0,`a`)) VIRTUAL,
  `g6` bigint GENERATED ALWAYS AS (cast((`a` * 2) as unsigned)) VIRTUAL,
  `g7` int GENERATED ALWAYS AS ((`a` between 1 and 5)) VIRTUAL,
  `g8` int GENERATED ALWAYS AS ((`a` in (1,2,3))) VIRTUAL,
  `g9` int GENERATED ALWAYS AS (-(`a`)) VIRTUAL,
  `g10` int GENERATED ALWAYS AS (((`a` DIV 2) + (`a` % 3))) VIRTUAL,
  `g11` varchar(30) GENERATED ALWAYS AS (substr(`s`,1,3)) VIRTUAL,
  `g12` int GENERATED ALWAYS AS ((((`a` > 1) and (`b` < 2)) or (`a` = 5))) VIRTUAL,
  `g13` int GENERATED ALWAYS AS ((`s` like _utf8mb4'ab%')) VIRTUAL,
  `g14` varchar(30) GENERATED ALWAYS AS (date_format(`d`,_utf8mb4'%Y')) VIRTUAL,
  `c1` int DEFAULT ((`a` + 1)),
  KEY `c_ms_fx` (((`a` * 2))),
  KEY `c_ms_fl` ((lower(`s`))),
  CONSTRAINT `c_ms_ck1` CHECK (((`a` > 0) and (`b` <> 3))),
  CONSTRAINT `c_ms_ck2` CHECK ((`s` in (_utf8mb4'x',_utf8mb4'y')))
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
