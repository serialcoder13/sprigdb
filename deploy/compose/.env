# Defaults for the development environment. Override on the command line,
# for example: MARIADB_IMAGE=mariadb:12.3 docker compose --profile single up -d
COMPOSE_PROJECT_NAME=sprigdb-dev
MARIADB_IMAGE=mariadb:11.8
ETCD_IMAGE=quay.io/coreos/etcd:v3.6.5
# Development credentials only; never reuse them.
MARIADB_ROOT_PASSWORD=sprig-dev-root
MARIADB_REPLICATION_PASSWORD=sprig-dev-repl
