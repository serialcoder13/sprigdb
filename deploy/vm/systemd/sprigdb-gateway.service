[Unit]
Description=SprigDB gateway
Documentation=https://github.com/modlix-india/sprigdb
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=sprigdb
Group=sprigdb
ExecStart=/usr/bin/sprigdb gateway --config /etc/sprigdb/sprigdb.toml
WatchdogSec=10s
