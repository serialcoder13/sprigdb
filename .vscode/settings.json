{
  // Keep VS Code's search and file watcher out of build output, agent work dirs and
  // runtime state. target/ alone holds tens of GB (agents' builds, downloaded suites),
  // and a workspace search over it spawned ~580 ripgrep processes on 10 Nov 2026.
  "search.exclude": {
    "**/target": true,
    "**/node_modules": true,
    "studio/dist": true,
    "deploy/compose/.gateway-dev": true,
    "deploy/compose/m07/.state": true
  },
  "files.watcherExclude": {
    "**/target/**": true,
    "**/node_modules/**": true,
    "studio/dist/**": true,
    "deploy/compose/.gateway-dev/**": true,
    "deploy/compose/m07/.state/**": true
  },
  "search.followSymlinks": false,
  "rust-analyzer.files.excludeDirs": ["target", "studio/node_modules"],
  // The Python extension's project discovery runs `rg --files --no-ignore --follow`
  // over the whole workspace, ignoring search.exclude; it spawned ~660 rg processes
  // into target/ on 10 Nov. Python here is only small scripts.
  "python.analysis.exclude": ["**/target/**", "**/node_modules/**", "studio/dist/**"],
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.indexing": false,
  "python.terminal.activateEnvironment": false
}
