{
  "name": "sprigdb-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
    "dev": "node scripts/sync-docs.mjs && astro dev",
    "build": "node scripts/sync-docs.mjs && astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "@astrojs/starlight": "0.42.7",
    "astro": "7.4.3"
  },
  "pnpm": {
    "overrides": {
      "sharp": "-"
    }
  },
  "//": "sharp is removed: its libvips binary is LGPL-3.0 (brief rule 14); astro.config.mjs uses the passthrough image service."
}
