# sprig-proto-mysql golden capture (tests/golden_capture.rs)
@target mysql-8.4
@server 8.4.11
@server_caps 0x00000000dfffffff
@caps 0x0000000001bfa285
@kind query
@framing plain
@command COM_QUERY SELECT 1 AS i, -1.5 AS d, 'x' AS s, NULL AS n, X'00FF' AS b, CAST('2024-01-02' AS DATE) AS dt, 18446744073709551615 AS big, REPEAT('z', 300) AS long_text, '' AS empty
C 00 
S 01 
