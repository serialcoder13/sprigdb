{"namespace": "Shop", "name": "PlaceOrder",
 "parameters": {
   "orderId": {"parameterName": "orderId", "schema": {"type": ["LONG"]}},
   "productId": {"parameterName": "productId", "schema": {"type": ["LONG"]}},
   "qty": {"parameterName": "qty", "schema": {"type": ["INTEGER"]}}},
 "events": {"output": {"name": "output", "parameters": {"left": {"type": ["INTEGER"]}, "orders": {"type": ["ARRAY"]}, "changed": {"type": ["INTEGER"]}}},
            "error": {"name": "error", "parameters": {"message": {"type": ["STRING"]}}}},
 "steps": {
  "take": {"statementName": "take", "namespace": "Sprig.Db", "name": "Exec",
    "parameterMap": {"sql": {"s": {"type": "VALUE", "value": "UPDATE products SET stock = stock - ? WHERE id = ? AND stock >= ?"}},
      "args": {"a": {"type": "EXPRESSION", "order": 1, "expression": "Arguments.qty"},
               "b": {"type": "EXPRESSION", "order": 2, "expression": "Arguments.productId"},
               "c": {"type": "EXPRESSION", "order": 3, "expression": "Arguments.qty"}}}},
  "ok": {"statementName": "ok", "namespace": "System", "name": "If",
    "parameterMap": {"condition": {"c": {"type": "EXPRESSION", "expression": "Steps.take.output.affected = 1"}}}},
  "add": {"statementName": "add", "namespace": "Sprig.Db", "name": "Exec",
    "dependentStatements": {"Steps.ok.true": true},
    "parameterMap": {"sql": {"s": {"type": "VALUE", "value": "INSERT INTO orders (id, product_id, qty, note) VALUES (?, ?, ?, CONCAT('it''s ', ?))"}},
      "args": {"a": {"type": "EXPRESSION", "order": 1, "expression": "Arguments.orderId"},
               "b": {"type": "EXPRESSION", "order": 2, "expression": "Arguments.productId"},
               "c": {"type": "EXPRESSION", "order": 3, "expression": "Arguments.qty"},
               "d": {"type": "EXPRESSION", "order": 4, "expression": "'order ' + Arguments.orderId"}}}},
  "left": {"statementName": "left", "namespace": "Sprig.Db", "name": "QueryOne",
    "dependentStatements": {"Steps.add.output": true},
    "parameterMap": {"sql": {"s": {"type": "VALUE", "value": "SELECT stock FROM products WHERE id = ?"}},
      "args": {"a": {"type": "EXPRESSION", "expression": "Arguments.productId"}}}},
  "list": {"statementName": "list", "namespace": "Sprig.Db", "name": "Query",
    "dependentStatements": {"Steps.left.output": true},
    "parameterMap": {"sql": {"s": {"type": "VALUE", "value": "SELECT id, qty, note FROM orders WHERE product_id = ? ORDER BY id"}},
      "args": {"a": {"type": "EXPRESSION", "expression": "Arguments.productId"}}}},
  "done": {"statementName": "done", "namespace": "System", "name": "GenerateEvent",
    "dependentStatements": {"Steps.list.output": true},
    "parameterMap": {"results": {
      "r1": {"type": "VALUE", "order": 1, "value": {"name": "left", "value": {"isExpression": true, "value": "Steps.left.output.row.stock"}}},
      "r2": {"type": "VALUE", "order": 2, "value": {"name": "orders", "value": {"isExpression": true, "value": "Steps.list.output.rows"}}},
      "r3": {"type": "VALUE", "order": 3, "value": {"name": "changed", "value": {"isExpression": true, "value": "Steps.take.output.affected"}}}}}},
  "no": {"statementName": "no", "namespace": "System", "name": "GenerateEvent",
    "dependentStatements": {"Steps.ok.false": true},
    "parameterMap": {"eventName": {"e": {"type": "VALUE", "value": "error"}},
      "results": {"r": {"type": "VALUE", "value": {"name": "message", "value": {"isExpression": true, "value": "'out of stock for ' + Arguments.productId"}}}}}}}}
