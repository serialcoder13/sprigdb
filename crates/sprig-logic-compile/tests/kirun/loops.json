{"namespace": "Test", "name": "Loops",
 "parameters": {
   "n": {"parameterName": "n", "schema": {"type": ["INTEGER"], "minimum": 0, "maximum": 50}},
   "stopAt": {"parameterName": "stopAt", "schema": {"type": ["INTEGER"]}},
   "items": {"parameterName": "items", "schema": {"type": ["ARRAY"]}}},
 "events": {"output": {"name": "output", "parameters": {
   "total": {"type": ["INTEGER"]}, "evens": {"type": ["INTEGER"]}, "stoppedAt": {"type": ["INTEGER"]},
   "spend": {"type": ["DOUBLE"]}, "count": {"type": ["INTEGER"]}, "down": {"type": ["DOUBLE"]}}}},
 "steps": {
  "mkTotal": {"statementName": "mkTotal", "namespace": "System.Context", "name": "Create",
    "parameterMap": {"name": {"x": {"type": "VALUE", "value": "total"}},
                     "schema": {"x": {"type": "VALUE", "value": {"type": "INTEGER", "defaultValue": 0}}}}},
  "mkEvens": {"statementName": "mkEvens", "namespace": "System.Context", "name": "Create",
    "parameterMap": {"name": {"x": {"type": "VALUE", "value": "evens"}},
                     "schema": {"x": {"type": "VALUE", "value": {"type": "INTEGER", "defaultValue": 0}}}}},
  "mkSpend": {"statementName": "mkSpend", "namespace": "System.Context", "name": "Create",
    "parameterMap": {"name": {"x": {"type": "VALUE", "value": "spend"}},
                     "schema": {"x": {"type": "VALUE", "value": {"type": "DOUBLE", "defaultValue": 0}}}}},
  "mkDown": {"statementName": "mkDown", "namespace": "System.Context", "name": "Create",
    "parameterMap": {"name": {"x": {"type": "VALUE", "value": "down"}},
                     "schema": {"x": {"type": "VALUE", "value": {"type": "DOUBLE", "defaultValue": 0}}}}},
  "range": {"statementName": "range", "namespace": "System.Loop", "name": "RangeLoop",
    "dependentStatements": {"Steps.mkTotal.output": true, "Steps.mkEvens.output": true},
    "parameterMap": {"from": {"x": {"type": "VALUE", "value": 1}},
                     "to": {"x": {"type": "EXPRESSION", "expression": "Arguments.n + 1"}}}},
  "addTotal": {"statementName": "addTotal", "namespace": "System.Context", "name": "Set",
    "dependentStatements": {"Steps.range.iteration": true},
    "parameterMap": {"name": {"x": {"type": "VALUE", "value": "Context.total"}},
                     "value": {"x": {"type": "EXPRESSION", "expression": "Context.total + Steps.range.iteration.index"}}}},
  "isEven": {"statementName": "isEven", "namespace": "System", "name": "If",
    "dependentStatements": {"Steps.range.iteration": true},
    "parameterMap": {"condition": {"x": {"type": "EXPRESSION", "expression": "Steps.range.iteration.index % 2 = 0"}}}},
  "addEven": {"statementName": "addEven", "namespace": "System.Context", "name": "Set",
    "dependentStatements": {"Steps.isEven.true": true},
    "parameterMap": {"name": {"x": {"type": "VALUE", "value": "Context.evens"}},
                     "value": {"x": {"type": "EXPRESSION", "expression": "Context.evens + 1"}}}},
  "count": {"statementName": "count", "namespace": "System.Loop", "name": "CountLoop",
    "dependentStatements": {"Steps.range.output": true},
    "parameterMap": {"count": {"x": {"type": "VALUE", "value": 1000}}}},
  "stop": {"statementName": "stop", "namespace": "System", "name": "If",
    "dependentStatements": {"Steps.count.iteration": true},
    "parameterMap": {"condition": {"x": {"type": "EXPRESSION", "expression": "Steps.count.iteration.index >= Arguments.stopAt"}}}},
  "brk": {"statementName": "brk", "namespace": "System.Loop", "name": "Break",
    "dependentStatements": {"Steps.stop.true": true},
    "parameterMap": {"stepName": {"x": {"type": "VALUE", "value": "count"}}}},
  "each": {"statementName": "each", "namespace": "System.Loop", "name": "ForEachLoop",
    "dependentStatements": {"Steps.mkSpend.output": true},
    "parameterMap": {"source": {"x": {"type": "EXPRESSION", "expression": "Arguments.items"}}}},
  "addSpend": {"statementName": "addSpend", "namespace": "System.Context", "name": "Set",
    "dependentStatements": {"Steps.each.iteration": true},
    "parameterMap": {"name": {"x": {"type": "VALUE", "value": "Context.spend"}},
                     "value": {"x": {"type": "EXPRESSION", "expression": "Context.spend + (Steps.each.iteration.each.price - 0) * (Steps.each.iteration.each.qty - 0)"}}}},
  "downLoop": {"statementName": "downLoop", "namespace": "System.Loop", "name": "RangeLoop",
    "dependentStatements": {"Steps.mkDown.output": true},
    "parameterMap": {"from": {"x": {"type": "VALUE", "value": 2.5}}, "to": {"x": {"type": "VALUE", "value": 0}},
                     "step": {"x": {"type": "VALUE", "value": -0.5}}}},
  "addDown": {"statementName": "addDown", "namespace": "System.Context", "name": "Set",
    "dependentStatements": {"Steps.downLoop.iteration": true},
    "parameterMap": {"name": {"x": {"type": "VALUE", "value": "Context.down"}},
                     "value": {"x": {"type": "EXPRESSION", "expression": "Context.down + Steps.downLoop.iteration.index"}}}},
  "out": {"statementName": "out", "namespace": "System", "name": "GenerateEvent",
    "dependentStatements": {"Steps.count.output": true, "Steps.each.output": true, "Steps.downLoop.output": true},
    "parameterMap": {"results": {
      "r1": {"type": "VALUE", "order": 1, "value": {"name": "total", "value": {"isExpression": true, "value": "Context.total"}}},
      "r2": {"type": "VALUE", "order": 2, "value": {"name": "evens", "value": {"isExpression": true, "value": "Context.evens"}}},
      "r3": {"type": "VALUE", "order": 3, "value": {"name": "stoppedAt", "value": {"isExpression": true, "value": "Steps.count.output.value"}}},
      "r4": {"type": "VALUE", "order": 4, "value": {"name": "spend", "value": {"isExpression": true, "value": "Context.spend"}}},
      "r5": {"type": "VALUE", "order": 5, "value": {"name": "count", "value": {"isExpression": true, "value": "Arguments.items.length"}}},
      "r6": {"type": "VALUE", "order": 6, "value": {"name": "down", "value": {"isExpression": true, "value": "Context.down"}}}}}}}}
